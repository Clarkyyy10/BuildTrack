{
  "name": "buildtrack",
  "version": "0.1.0",
  "private": true,
  "description": "BuildTrack — project-centered construction information, monitoring, and accountability system.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace server run build && npm --workspace client run build",
    "db:migrate": "npm --workspace server run db:migrate",
    "db:seed": "npm --workspace server run db:seed",
    "db:reset": "npm --workspace server run db:reset"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
